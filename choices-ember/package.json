{
  "name": "choices-ember",
  "version": "0.1.0",
  "description": "Ember v2 addon: reactive Choices.js bridge with optional daisyUI fieldset chrome",
  "keywords": [
    "ember-addon",
    "choices.js",
    "select",
    "glimmer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultish/choices-ember.git",
    "directory": "choices-ember"
  },
  "homepage": "https://github.com/ultish/choices-ember#readme",
  "bugs": {
    "url": "https://github.com/ultish/choices-ember/issues"
  },
  "license": "MIT",
  "author": "",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./dist/styles/*",
    "./styles/choices-default.css": "./dist/styles/choices-default.css",
    "./styles/daisyui-theme.css": "./dist/styles/daisyui-theme.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "@glimmer/component": "^2.0.0",
    "decorator-transforms": "^2.2.2",
    "ember-modifier": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@babel/runtime": "^7.25.6",
    "@ember/library-tsconfig": "^1.1.3",
    "@embroider/addon-dev": "^8.3.1",
    "@eslint/js": "^9.17.0",
    "@glint/ember-tsc": "^1.10.0",
    "@glint/template": "^1.8.0",
    "@glint/tsserver-plugin": "^2.7.0",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^2.2.5",
    "choices.js": "^11.0.0",
    "concurrently": "^9.0.1",
    "ember-template-lint": "^6.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "rollup": "^4.22.5",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.19.1"
  },
  "peerDependencies": {
    "choices.js": "^11.0.0",
    "daisyui": ">= 5.0.0",
    "ember-source": ">= 6.0.0",
    "tailwindcss": ">= 4.0.0"
  },
  "peerDependenciesMeta": {
    "daisyui": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/choices-fieldset.js": "./dist/_app_/components/choices-fieldset.js",
      "./components/choices.js": "./dist/_app_/components/choices.js"
    }
  }
}
